diff --git a/Makefile b/Makefile
new file mode 100644
index 0000000..ae3af19
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,34 @@
+# CP/M Neo — builds sysgen and generates a disk image + bootloader for a
+# given platform/arch.
+#
+# Usage:
+#   make sysgen - build sysgen/build/sysgen (the disk/bootloader generator)
+#   make disk   - build sysgen, then run "sysgen new" with DISK_SIZE/
+#                 MEM_SIZE/PLATFORM/ARCH. Produces sysgen/build/disk.img
+#                 and sysgen/build/core/int/bootloader.elf
+#   make clean  - remove sysgen/build
+#
+
+SYSGEN_DIR := sysgen
+SYSGEN_BIN := $(SYSGEN_DIR)/build/sysgen
+
+DISK_SIZE ?= 128K
+MEM_SIZE  ?= 32K
+PLATFORM  ?= tinymcu
+ARCH      ?= tinymcu-riscv32
+
+.PHONY: sysgen disk clean
+
+sysgen: $(SYSGEN_BIN)
+
+$(SYSGEN_BIN):
+	$(MAKE) -C $(SYSGEN_DIR)
+
+disk: $(SYSGEN_BIN)
+	./$(SYSGEN_BIN) new \
+		--disk-size=$(DISK_SIZE) --mem=$(MEM_SIZE) \
+		--no-sys --no-extra \
+		--platform=$(PLATFORM) --arch=$(ARCH)
+
+clean:
+	rm -rf $(SYSGEN_DIR)/build
diff --git a/arch/tinymcu-riscv32/boot.S b/arch/tinymcu-riscv32/boot.S
new file mode 100644
index 0000000..346cead
--- /dev/null
+++ b/arch/tinymcu-riscv32/boot.S
@@ -0,0 +1,173 @@
+/*
+ * bootloader/boot.S
+ * CP/M Neo 32-bit RISV-V Bootloader
+ */
+
+/* S0 (sector-0) field offsets come from core/kernel/s0_layout.h — the single
+ * source of truth shared with the kernel and sysgen. boot.S is compiled via
+ * the C compiler, so the preprocessor substitutes the values below. */
+
+#include "s0_layout.h"
+
+.equ DISK_MAGIC,      0x4350
+.equ BOOT_SIG,        0xAA55
+.equ BOOT_MAGIC,      DISK_MAGIC
+
+.equ SECTOR_SIZE,    512
+
+/* ASCII values */
+.equ CH_0,   0x30
+.equ CH_DOT, 0x2E
+
+.extern bios_read
+.extern bios_conout
+.extern bios_init
+
+.section .boot, "ax"
+.global _boot_start
+.align 2
+
+_boot_start:
+    /* Volatile boot RAM lives as low as possible, right after the boot code:
+     * the 512-byte sector-0 scratch buffer (__boot_scratch) and a 128-byte
+     * stack just above it (__boot_stack_top), both from linker_boot.ld. */
+    la   sp, __boot_stack_top
+    la   s7, __boot_scratch
+
+    /* TinyMCU-specific: unlike vemu's virtual UART, the real UART needs
+     * CONFIG/BAUDRATE configured before bios_conout() can transmit
+     * anything because both reset to 0, and BAUDRATE=0 breaks the Tx state
+     * machine's bit timing entirely (see platform/tinymcu/bios.c's
+     * bios_init()). Call it before the first bios_read()/bios_conout(). */
+    jal  ra, bios_init
+
+    /* Load sector 0 → scratch buffer */
+    li   a0, 0
+    mv   a1, s7
+    jal  ra, bios_read
+    bltz a0, err_disk
+
+    /* Verify 0xAA55 signature */
+    li   t0, S0_SIG
+    add  t0, s7, t0
+    lhu  t0, 0(t0)
+    li   t1, BOOT_SIG
+    bne  t0, t1, err_disk
+
+    /* Print banner ("Loading CP/M Neo ...\n\n") */
+    la   t0, msg_prefix
+    jal  ra, print_str
+
+    /* Print ASCII art */
+    la   t0, msg_art_1
+    jal  ra, print_str
+    la   t0, msg_art_2
+    jal  ra, print_str
+    la   t0, msg_art_3
+    jal  ra, print_str
+    la   t0, msg_art_4
+    jal  ra, print_str
+    la   t0, msg_art_5
+    jal  ra, print_str
+
+    /* Load kernel target address safely (handling 2-byte alignment at 0x006) */
+    lhu  s1, S0_KERN_LOAD(s7)
+    lhu  t0, (S0_KERN_LOAD + 2)(s7)
+    slli t0, t0, 16
+    or   s1, s1, t0            /* s1 = 32-bit load address */
+
+    lhu  s2, S0_KERN_SECTORS(s7)
+    lhu  s6, S0_KERN_LBA(s7)
+    beqz s2, err_disk
+
+    /* Load kernel binary — use saved registers across bios_read calls */
+    mv   s3, s1                /* Target RAM destination */
+    mv   s4, s6                /* Sector LBA */
+    mv   s5, s2                /* Sector count remaining */
+
+.Lload_kern:
+    mv   a0, s4
+    mv   a1, s3
+    jal  ra, bios_read
+    bltz a0, err_disk      /* bios_read: negative return = read failure */
+    addi s3, s3, SECTOR_SIZE
+    addi s4, s4, 1
+    addi s5, s5, -1
+    bnez s5, .Lload_kern
+
+    /* Verify 16-bit kernel magic at end of loaded buffer */
+    slli t0, s2, 9             /* total bytes loaded */
+    add  t0, s1, t0            /* end pointer */
+    lhu  t0, -4(t0)            /* load 16-bit halfword magic */
+    li   t1, BOOT_MAGIC
+    bne  t0, t1, err_kernel
+
+    /* Jump to kernel */
+    jalr zero, s1, 0
+
+/* ── Helper Routines ─────────────────────────────────────── */
+
+print_ver:
+    addi sp, sp, -8
+    sw   ra, 4(sp)
+    sw   s0, 0(sp)
+    mv   s0, t0                /* Preserve version value */
+
+    srli a0, s0, 8
+    andi a0, a0, 0xFF
+    addi a0, a0, CH_0
+    jal  ra, bios_conout
+
+    li   a0, CH_DOT
+    jal  ra, bios_conout
+
+    andi a0, s0, 0xFF
+    addi a0, a0, CH_0
+    jal  ra, bios_conout
+
+    lw   s0, 0(sp)
+    lw   ra, 4(sp)
+    addi sp, sp, 8
+    ret
+
+print_str:
+    addi sp, sp, -8
+    sw   ra, 4(sp)
+    sw   s0, 0(sp)
+    mv   s0, t0                /* Use s0 to hold string pointer */
+
+.Lstr_loop:
+    lbu  a0, 0(s0)
+    beqz a0, .Ldone_str
+    addi s0, s0, 1
+    jal  ra, bios_conout
+    j    .Lstr_loop
+
+.Ldone_str:
+    lw   s0, 0(sp)
+    lw   ra, 4(sp)
+    addi sp, sp, 8
+    ret
+
+/* ── Error paths ─────────────────────────────────────────── */
+err_kernel:
+    la   t0, msg_err_kernel
+    j    .Lhalt
+err_disk:
+    la   t0, msg_err_disk
+.Lhalt:
+    jal  ra, print_str
+.Lspin:
+    j    .Lspin
+
+/* ── Strings ─────────────────────────────────────────────── */
+msg_prefix:     .asciz "Loading CP/M Neo ...\n\n"
+msg_art_1:      .asciz "   ____ ____   ____  __   _   _ _____ ___  \n"
+msg_art_2:      .asciz "  / ___|  _ \\ / /  \\/  | | \\ | | ____/ _ \\ \n"
+msg_art_3:      .asciz " | |   | |_) / /| |\\/| | |  \\| |  _|| | | |\n"
+msg_art_4:      .asciz " | |___|  __/ / | |  | | | |\\  | |__| |_| |\n"
+msg_art_5:      .asciz "  \\____|_| /_/  |_|  |_| |_| \\_|_____\\___/ \n"
+msg_err_disk:   .asciz "  \nDISK ERR\n"
+msg_err_kernel: .asciz "  \nKERNEL ERR\n"
+
+.hword 0xAA55
\ No newline at end of file
